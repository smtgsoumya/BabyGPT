MIN_ELO = 1500
MIN_PLIES = 10
MAX_GAMES = 15000

def stream_games_from_zst(path, max_games):
    games = []
    dctx = zstd.ZstdDecompressor()
    with open(path, "rb") as fh:
        with dctx.stream_reader(fh) as reader:
            text_stream = io.TextIOWrapper(reader, encoding="utf-8")
            while len(games) < max_games:
                game = chess.pgn.read_game(text_stream)
                if game is None:
                    break

                try:
                    white_elo = int(game.headers.get("WhiteElo", 0))
                    black_elo = int(game.headers.get("BlackElo", 0))
                except ValueError:
                    continue
                if white_elo < MIN_ELO or black_elo < MIN_ELO:
                    continue

                if not is_good_time_control(game):
                    continue

                if game.headers.get("Termination", "") != "Normal":
                    continue

                result = game.headers.get("Result", "*")
                if result not in special_to_id:
                    continue

                move_ids = []
                skip_game = False
                for move in game.mainline_moves():
                    try:
                        move_ids.append(move_to_token_id(move))
                    except KeyError:
                        skip_game = True
                        break

                if skip_game or len(move_ids) < MIN_PLIES:
                    continue

                games.append((move_ids, result))
    return games

real_games = stream_games_from_zst(LOCAL_ZST_PATH, MAX_GAMES)
