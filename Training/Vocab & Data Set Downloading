PROMOTION_PIECES = [None, chess.QUEEN, chess.ROOK, chess.BISHOP, chess.KNIGHT]

def build_move_vocab():
    moves = set()
    for from_sq in chess.SQUARES:
        from_file = chess.square_file(from_sq)
        from_rank = chess.square_rank(from_sq)
        for to_sq in chess.SQUARES:
            if to_sq == from_sq:
                continue
            to_file = chess.square_file(to_sq)
            to_rank = chess.square_rank(to_sq)
            d_file = to_file - from_file
            d_rank = to_rank - from_rank
            is_straight = (d_file == 0 or d_rank == 0)
            is_diagonal = (abs(d_file) == abs(d_rank))
            is_knight = (abs(d_file), abs(d_rank)) in [(1, 2), (2, 1)]
            if is_straight or is_diagonal or is_knight:
                moves.add((from_sq, to_sq, None))
                if (from_rank == 6 and to_rank == 7) or (from_rank == 1 and to_rank == 0):
                    for promo in PROMOTION_PIECES[1:]:
                        moves.add((from_sq, to_sq, promo))

    moves = sorted(moves, key=lambda m: (m[0], m[1], -1 if m[2] is None else m[2]))
    move_to_id = {m: i for i, m in enumerate(moves)}
    id_to_move = {i: m for i, m in enumerate(moves)}
    return move_to_id, id_to_move

move_to_id, id_to_move = build_move_vocab()
NUM_MOVE_TOKENS = len(move_to_id)

SPECIAL_TOKENS = ["<START>", "1-0", "0-1", "1/2-1/2", "*"]
special_to_id = {tok: NUM_MOVE_TOKENS + i for i, tok in enumerate(SPECIAL_TOKENS)}
id_to_special = {v: k for k, v in special_to_id.items()}

vocab_size = NUM_MOVE_TOKENS + len(SPECIAL_TOKENS)

def move_to_token_id(move: chess.Move) -> int:
    return move_to_id[(move.from_square, move.to_square, move.promotion)]

def token_id_to_move(token_id: int) -> chess.Move:
    from_sq, to_sq, promo = id_to_move[token_id]
    return chess.Move(from_sq, to_sq, promotion=promo)

def is_good_time_control(game, min_base_seconds=180):
    tc = game.headers.get("TimeControl", "-")
    if tc == "-":
        return False
    try:
        base_seconds = int(tc.split("+")[0])
    except ValueError:
        return False
    return base_seconds >= min_base_seconds

