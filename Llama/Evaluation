# ------------------------------------------------------------
# 1. Stockfish Evaluation & Interestingness Functions
# ------------------------------------------------------------
def analyze_game_interestingness(board, stockfish_path=STOCKFISH_PATH, depth=STOCKFISH_DEPTH):
    """
    Evaluates position sharpness and game interestingness using Stockfish.
    Calculates CP evals per ply, standard deviation (sharpness), and avg swing (interest).
    """
    if not os.path.exists(stockfish_path):
        return 0.0, 0.0

    engine = chess.engine.SimpleEngine.popen_uci(stockfish_path)
    eval_board = chess.Board()
    cp_evals = []

    for move in board.move_stack:
        eval_board.push(move)
        info = engine.analyse(eval_board, chess.engine.Limit(depth=depth))
        score = info["score"].white()

        if score.is_mate():
            cp = 10000 if score.mate() > 0 else -10000
        else:
            cp = score.score()
        cp_evals.append(cp)

    engine.quit()

    if not cp_evals:
        return 0.0, 0.0

    sharpness_raw = statistics.stdev(cp_evals) if len(cp_evals) > 1 else 0.0
    eval_swings = sum(abs(cp_evals[i] - cp_evals[i-1]) for i in range(1, len(cp_evals)))
    avg_swing = eval_swings / max(len(cp_evals) - 1, 1)

    raw_interest = (sharpness_raw * 0.4) + (avg_swing * 0.6)
    interestingness = 100.0 * (1.0 - math.exp(-raw_interest / 350.0))
    sharpness_scaled = 100.0 * math.exp(-sharpness_raw / 300.0)

    return sharpness_scaled, interestingness

def get_game_winner(board):
    """Determines game outcome string from board state."""
    outcome = board.outcome()
    if outcome is None:
        return "Truncated / Unfinished"
    if outcome.winner == chess.WHITE:
        return "White Win"
    elif outcome.winner == chess.BLACK:
        return "Black Win"
    else:
        return "Draw"

# ------------------------------------------------------------
# 2. Ollama PGN Move Generation Helper
# ------------------------------------------------------------
def generate_from_prefix_with_ollama(prefix_moves, max_moves=100, temperature=BEST_TEMPERATURE):
    """
    Generates chess game continuation using local Ollama instance starting from prefix_moves.
    """
    board = chess.Board()
    prefix_san = []

    for move in prefix_moves:
        prefix_san.append(board.san(move))
        board.push(move)

    prefix_str = " ".join(prefix_san)
    prompt = (
        f"Complete this chess game continuation in standard PGN notation starting after these moves: {prefix_str}. "
        f"Provide only legal SAN moves separated by spaces."
    )

    payload = {
        "model": OLLAMA_MODEL,
        "prompt": prompt,
        "temperature": temperature,
        "stream": False
    }

    try:
        response = requests.post(OLLAMA_URL, json=payload).json()
        generated_text = response.get("response", "")
    except Exception as e:
        print(f"Ollama generation error: {e}")
        return board

    # Clean and parse text response into legal board moves
    raw_tokens = generated_text.replace("\n", " ").split()
    moves_added = 0

    for token in raw_tokens:
        if moves_added >= max_moves or board.is_game_over():
            break

        # Clean move text (remove move numbers like "1.", "2...", symbols)
        clean_token = token.rstrip(".?!,").split(".")[-1]
        if not clean_token:
            continue

        try:
            parsed_move = board.parse_san(clean_token)
            board.push(parsed_move)
            moves_added += 1
        except ValueError:
            # Skip invalid or ill-formed move tokens generated by model
            continue

    return board

# ------------------------------------------------------------
# 3. Lichess Held-Out PGN Dataset Loader
# ------------------------------------------------------------
HOLDOUT_PGN_URL = "https://database.lichess.org/standard/lichess_db_standard_rated_2016-08.pgn.zst"
HOLDOUT_LOCAL_ZST_PATH = "holdout_games.pgn.zst"
HOLDOUT_GAMES_PATH = f"{RESULTS_DIR}/games/holdout_games.json"
NUM_HOLDOUT_GAMES = 100
HOLDOUT_MIN_PLIES = 160
HOLDOUT_MIN_ELO = 1500

def is_good_time_control(game, min_base_seconds=180):
    tc = game.headers.get("TimeControl", "-")
    if tc == "-":
        return False
    try:
        base_seconds = int(tc.split("+")[0])
    except ValueError:
        return False
    return base_seconds >= min_base_seconds

def download_and_fix_holdout_games(num_games=NUM_HOLDOUT_GAMES, min_plies=HOLDOUT_MIN_PLIES):
    """Downloads and parses held-out PGN games from Lichess dataset."""
    if os.path.exists(HOLDOUT_GAMES_PATH):
        print(f"Loading cached held-out games from {HOLDOUT_GAMES_PATH}")
        with open(HOLDOUT_GAMES_PATH, "r") as f:
            saved = json.load(f)
        return [[chess.Move.from_uci(u) for u in g["moves_uci"]] for g in saved]

    print(f"Downloading held-out PGN archive: {HOLDOUT_PGN_URL}")
    import urllib.request
    import zstandard as zstd

    urllib.request.urlretrieve(HOLDOUT_PGN_URL, HOLDOUT_LOCAL_ZST_PATH)

    games = []
    games_to_save = []
    dctx = zstd.ZstdDecompressor()

    with open(HOLDOUT_LOCAL_ZST_PATH, "rb") as fh:
        with dctx.stream_reader(fh) as reader:
            text_stream = io.TextIOWrapper(reader, encoding="utf-8")
            while len(games) < num_games:
                game = chess.pgn.read_game(text_stream)
                if game is None:
                    break

                try:
                    white_elo = int(game.headers.get("WhiteElo", 0))
                    black_elo = int(game.headers.get("BlackElo", 0))
                except ValueError:
                    continue

                if white_elo < HOLDOUT_MIN_ELO or black_elo < HOLDOUT_MIN_ELO:
                    continue
                if not is_good_time_control(game):
                    continue
                if game.headers.get("Termination", "") != "Normal":
                    continue

                moves = list(game.mainline_moves())
                if len(moves) < min_plies:
                    continue

                games.append(moves)
                games_to_save.append({"moves_uci": [m.uci() for m in moves]})

    os.makedirs(os.path.dirname(HOLDOUT_GAMES_PATH), exist_ok=True)
    with open(HOLDOUT_GAMES_PATH, "w") as f:
        json.dump(games_to_save, f, indent=2)

    print(f"Saved {len(games)} held-out games to {HOLDOUT_GAMES_PATH}")
    return games
